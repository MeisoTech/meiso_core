# Root-owned shell assignments. Replace deployment values; do not commit device IDs.
MEISO_PREFIX=/opt/meiso/current
MEISO_HOST_IP=192.0.2.1
MEISO_LOCAL_PEER=REPLACE_WITH_EDGE_32_HEX_DIGITS
MEISO_EXPECTED_PEER=REPLACE_WITH_HOST_32_HEX_DIGITS
MEISO_CONTROL_PORT=4440
MEISO_MEDIA_PORT=4441
MEISO_EDGE_MEDIA_PORT=4442
MEISO_DRM_DEVICE=/dev/dri/card0
MEISO_WIDTH=1280
MEISO_HEIGHT=720
MEISO_VIDEO_LAYOUT=side-by-side
# Optional real CameraMedia uplink: enable BOTH and use the Host's camera port.
# Confirm the device is an ISP capture node on this board, not its VPU decoder.
# MEISO_CAMERA_DEVICE=/dev/video1
# MEISO_CAMERA_PORT=4443
